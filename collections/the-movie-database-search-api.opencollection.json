{
  "opencollection": "1.0.0",
  "info": {
    "name": "tmdb-api Account Search API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.themoviedb.org/3/search/collection",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "include_adult",
                "value": "",
                "type": "query"
              },
              {
                "name": "language",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "region",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search for collections by their original, translated and alternative names."
        },
        {
          "info": {
            "name": "Company",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.themoviedb.org/3/search/company",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search for companies by their original and alternative names."
        },
        {
          "info": {
            "name": "Keyword",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.themoviedb.org/3/search/keyword",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search for keywords by their name."
        },
        {
          "info": {
            "name": "Movie",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.themoviedb.org/3/search/movie",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "include_adult",
                "value": "",
                "type": "query"
              },
              {
                "name": "language",
                "value": "",
                "type": "query"
              },
              {
                "name": "primary_release_year",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "region",
                "value": "",
                "type": "query"
              },
              {
                "name": "year",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search for movies by their original, translated and alternative titles."
        },
        {
          "info": {
            "name": "Multi",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.themoviedb.org/3/search/multi",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "include_adult",
                "value": "",
                "type": "query"
              },
              {
                "name": "language",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Use multi search when you want to search for movies, TV shows and people in a single request."
        },
        {
          "info": {
            "name": "Person",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.themoviedb.org/3/search/person",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "include_adult",
                "value": "",
                "type": "query"
              },
              {
                "name": "language",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search for people by their name and also known as names."
        },
        {
          "info": {
            "name": "TV",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.themoviedb.org/3/search/tv",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "first_air_date_year",
                "value": "",
                "type": "query",
                "description": "Search only the first air date. Valid values are: 1000..9999"
              },
              {
                "name": "include_adult",
                "value": "",
                "type": "query"
              },
              {
                "name": "language",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "year",
                "value": "",
                "type": "query",
                "description": "Search the first air date and all episode air dates. Valid values are: 1000..9999"
              }
            ]
          },
          "docs": "Search for TV shows by their original, translated and also known as names."
        }
      ]
    }
  ],
  "bundled": true
}